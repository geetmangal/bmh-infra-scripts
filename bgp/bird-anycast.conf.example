# BIRD 2 snippet for use with anycast-healthcheck.py
#
# Mode A (default): the script runs `birdc disable|enable anycast_static`.
protocol static anycast_static {
    ipv4;
    route 203.0.113.53/32 blackhole;   # the loopback-bound anycast address
}

# Mode B (bird_state_file: /etc/bird/anycast-state.conf): the script rewrites
# the include file with or without the route and runs `birdc configure`.
# protocol static anycast_static {
#     ipv4;
#     include "/etc/bird/anycast-state.conf";
# }

filter export_anycast {
    if proto = "anycast_static" then accept;
    reject;
}

protocol bgp upstream {
    local as 65001;
    neighbor 192.0.2.1 as 65000;
    ipv4 { export filter export_anycast; import none; };
}
